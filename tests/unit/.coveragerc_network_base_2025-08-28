[run]
source = utilities.network.network_connectivity_complex.core.network_base
omit = 
    */tests/*
    */test_*
    */__pycache__/*
    */venv/*
    */env/*
    */.tox/*
    */build/*
    */dist/*
    */.pytest_cache/*
    */migrations/*

branch = true
parallel = false
concurrency = thread

[report]
precision = 2
show_missing = true
skip_covered = false
skip_empty = false
sort = Cover

exclude_lines =
    pragma: no cover
    def __repr__
    if self.debug:
    if settings.DEBUG
    raise AssertionError
    raise NotImplementedError
    if 0:
    if __name__ == .__main__.:
    class .*\(Protocol\):
    @(abc\.)?abstractmethod

[html]
directory = coverage_network_base_2025-08-28
title = Network Base Coverage Report - 2025-08-28
show_contexts = true

[json]
output = result_network_base_coverage_2025-08-28.json
pretty_print = true
show_contexts = true

[xml]
output = result_network_base_coverage_2025-08-28.xml