# EditorConfig for RFU Project
# https://editorconfig.org
# FE-02.3: Multi-IDE Configuration Support

# Top-level configuration
root = true

# Default settings for all files
[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python files
[*.py]
indent_size = 4
max_line_length = 79

# Configuration files
[*.{json,yaml,yml,toml}]
indent_size = 2

# Markdown files
[*.md]
trim_trailing_whitespace = false
max_line_length = 120

# Shell scripts
[*.{sh,bash}]
indent_size = 2
end_of_line = lf

# Batch files (Windows)
[*.{bat,cmd}]
end_of_line = crlf

# PowerShell
[*.{ps1,psm1,psd1}]
indent_size = 4
end_of_line = crlf

# Requirements and pip files
[requirements*.txt]
insert_final_newline = true

# INI/CFG files
[*.{ini,cfg}]
indent_size = 4

# HTML/XML
[*.{html,htm,xml,xhtml}]
indent_size = 2

# CSS/SCSS
[*.{css,scss,sass}]
indent_size = 2

# JavaScript/TypeScript
[*.{js,ts,jsx,tsx}]
indent_size = 2

# SQL files
[*.sql]
indent_size = 2

# Makefiles require tabs
[Makefile]
indent_style = tab
indent_size = 4

# Git configuration
[.git*]
indent_size = 4

# CI/CD files
[*.{yml,yaml}]
indent_size = 2

# pytest configuration
[pytest.ini]
indent_size = 4

# setup.cfg
[setup.cfg]
indent_size = 4
