    "content": "import os\nimport time\nfrom PyQt5.QtCore import QObject, pyqtSignal\n\nclass EmptyFolderLogic(QObject):\n    \"\"\"Handles the logic for finding and deleting empty folders.\"\"\"\n    progress_updated = pyqtSignal(str)  # Signal to update status message\n    folders_found = pyqtSignal(list)    # Signal emitting list of found empty folders\n    deletion_update = pyqtSignal(str, bool) # Signal for each deletion attempt (path, success)\n    error_occurred = pyqtSignal(str)    # Signal for general errors\n    finished = pyqtSignal(bool)         # Signal when operation completes (True=find, False=delete)\n\n    def __init__(self):\n        super().__init__()\n        self._is_running = False\n        self._base_path = None\n\n    def stop(self):\n        self.progress_updated.emit(\"Stopping operation...\")\n        self._is_running = False\n\n    def find_empty_folders(self, start_path):\n        \"\"\"Starts the process of finding empty folders recursively.\"\"\"\n        if not os.path.isdir(start_path):\n            self.error_occurred.emit(f\"Error: Path is not a valid directory: {start_path}\")\n            self.finished.emit(True)\n            return\n\n        self._is_running = True\n        self._base_path = start_path\n        empty_folders = []\n        folders_to_check = []\n\n        self.progress_updated.emit(f\"Scanning directory: {start_path}...\")\n\n        try:\n            # First pass: Collect all directory paths using topdown=True for efficiency\n            for root, dirs, files in os.walk(start_path, topdown=True):\n                if not self._is_running: break\n                # Add full paths of directories found in this level\n                for d in dirs:\n                    if not self._is_running: break\n                    dir_path = os.path.join(root, d)\n                    folders_to_check.append(dir_path)\n                    # Provide some feedback during long scans\n                    if len(folders_to_check) % 100 == 0:\n                         self.progress_updated.emit(f\"Scanning... Found {len(folders_to_check)} potential folders.\")\n                if not self._is_running: break\n                # Add the root itself if it's the starting point\n                if root == start_path:\n                     folders_to_check.append(root)\n\n            if not self._is_running:\n                self.progress_updated.emit(\"Scan cancelled.\")\n                self.finished.emit(True)\n                return\n\n            # Second pass: Check collected directories for emptiness (more reliable)\n            # Iterate in reverse length order - potentially catching nested empty dirs first\n            # although the deletion logic handles nesting better.\n            checked_count = 0\n            total_to_check = len(folders_to_check)\n            folders_to_check.sort(key=len, reverse=True)\n\n            for folder_path in folders_to_check:\n                if not self._is_running: break\n                checked_count += 1\n                if checked_count % 50 == 0:\n                    self.progress_updated.emit(f\"Checking folder {checked_count}/{total_to_check}: {os.path.basename(folder_path)}\")\n                try:\n                    # Check if directory exists and is empty\n                    if os.path.isdir(folder_path) and not os.listdir(folder_path):\n                        empty_folders.append(folder_path)\n                except PermissionError:\n                    self.progress_updated.emit(f\"Skipping (permission denied): {folder_path}\")\n                except FileNotFoundError: # Can happen if a parent was deleted during the run (unlikely here)\n                     self.progress_updated.emit(f\"Skipping (not found): {folder_path}\")\n                except Exception as e:\n                     self.progress_updated.emit(f\"Skipping (error checking {os.path.basename(folder_path)}): {e}\")\n\n            if self._is_running:\n                self.folders_found.emit(empty_folders)\n                self.progress_updated.emit(f\"Scan complete. Found {len(empty_folders)} empty folders.\")\n\n        except Exception as e:\n            if self._is_running: # Only emit error if not stopped manually\n                self.error_occurred.emit(f\"An error occurred during scan: {e}\")\n        finally:\n            if self._is_running: # Don't emit finished if stopped manually\n                 self._is_running = False\n                 self.finished.emit(True) # True indicates find operation finished\n\n    def delete_folders(self, folder_paths):\n        \"\"\"Attempts to delete the provided list of folder paths.\"\"\"\n        if not folder_paths:\n            self.progress_updated.emit(\"No folders selected for deletion.\")\n            self.finished.emit(False)\n            return\n\n        self._is_running = True\n        # Sort by path length in reverse order to delete nested folders first\n        folders_to_delete = sorted(folder_paths, key=len, reverse=True)\n        deleted_count = 0\n        failed_count = 0\n\n        self.progress_updated.emit(f\"Starting deletion of {len(folders_to_delete)} folders...\")\n\n        for folder_path in folders_to_delete:\n            if not self._is_running: break\n            try:\n                if os.path.exists(folder_path) and os.path.isdir(folder_path):\n                    os.rmdir(folder_path)\n                    self.deletion_update.emit(folder_path, True)\n                    deleted_count += 1\n                else:\n                    # Folder might have been deleted already (e.g., nested) or isn't a dir anymore\n                    self.deletion_update.emit(f\"{folder_path} (Not found or not a directory)\", False)\n                    failed_count +=1\n\n            except OSError as e:\n                # OSError could be PermissionError or 'Directory not empty'\n                self.deletion_update.emit(f\"{folder_path} ({e.strerror})\", False)\n                failed_count += 1\n            except Exception as e:\n                self.deletion_update.emit(f\"{folder_path} (Unexpected error: {e})\", False)\n                failed_count += 1\n            # Small delay to allow GUI updates\n            # time.sleep(0.01)\n\n        if not self._is_running:\n            self.progress_updated.emit(\"Deletion cancelled.\")\n        else:\n            self.progress_updated.emit(f\"Deletion complete. Deleted: {deleted_count}, Failed: {failed_count}\")\n\n        self._is_running = False\n        self.finished.emit(False) # False indicates delete operation finished\n"
