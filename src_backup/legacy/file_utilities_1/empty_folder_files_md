    "content": "import sys\nimport os\nfrom PyQt5.QtWidgets import (\n    QApplication, QMainWindow, QWidget, QVBoxLayout, QHBoxLayout,\n    QPushButton, QLabel, QLineEdit, QFileDialog, QListWidget,\n    QStatusBar, QMessageBox, QListWidgetItem, QAbstractItemView,\n    QSizePolicy\n)\nfrom PyQt5.QtCore import Qt, QThread, pyqtSignal, QObject\nfrom PyQt5.QtGui import QColor\n\nfrom empty_folder_logic import EmptyFolderLogic\n\nclass Worker(QObject):\n    \"\"\"Worker to run logic methods in a separate thread.\"\"\"\n    # Define signals that mirror the logic signals\n    progress_updated = pyqtSignal(str)\n    folders_found = pyqtSignal(list)\n    deletion_update = pyqtSignal(str, bool)\n    error_occurred = pyqtSignal(str)\n    finished = pyqtSignal(bool)\n\n    def __init__(self, logic_instance):\n        super().__init__()\n        self.logic = logic_instance\n        self._is_running = False\n        self._mode = None # 'find' or 'delete'\n        self._args = None\n\n    def run(self):\n        self._is_running = True\n        # Connect logic signals to worker signals\n        self.logic.progress_updated.connect(self.progress_updated)\n        self.logic.folders_found.connect(self.folders_found)\n        self.logic.deletion_update.connect(self.deletion_update)\n        self.logic.error_occurred.connect(self.error_occurred)\n        self.logic.finished.connect(self.finish_task)\n\n        try:\n            if self._mode == 'find' and self._args:\n                self.logic.find_empty_folders(self._args[0])\n            elif self._mode == 'delete' and self._args:\n                self.logic.delete_folders(self._args[0])\n            else:\n                 self.error_occurred.emit(\"Worker started with invalid mode or arguments.\")\n                 self.finish_task(False) # Indicate generic finish\n\n        except Exception as e:\n             self.error_occurred.emit(f\"Critical error in worker execution: {e}\")\n             self.finish_task(False) # Indicate generic finish\n\n    def start_find(self, path):\n        self._mode = 'find'\n        self._args = [path]\n\n    def start_delete(self, paths):\n        self._mode = 'delete'\n        self._args = [paths]\n\n    def stop(self):\n        if self._is_running:\n             self.logic.stop()\n\n    def finish_task(self, mode_flag):\n         self._is_running = False\n         # Disconnect signals to prevent duplicates if reused (though typically create new worker)\n         try:\n             self.logic.progress_updated.disconnect(self.progress_updated)\n             self.logic.folders_found.disconnect(self.folders_found)\n             self.logic.deletion_update.disconnect(self.deletion_update)\n             self.logic.error_occurred.disconnect(self.error_occurred)\n             self.logic.finished.disconnect(self.finish_task)\n         except TypeError:\n              pass # Ignore if signals were already disconnected\n         self.finished.emit(mode_flag)\n\n\nclass EmptyFolderCleanerApp(QMainWindow):\n    def __init__(self):\n        super().__init__()\n        self.setWindowTitle(\"Empty Folder Cleaner\")\n        self.setGeometry(100, 100, 800, 600)\n\n        self.central_widget = QWidget()\n        self.setCentralWidget(self.central_widget)\n        self.layout = QVBoxLayout(self.central_widget)\n\n        # --- Worker Thread Setup ---\n        self.thread = None\n        self.worker = None\n        self.logic = EmptyFolderLogic() # Create one instance of logic\n\n        # --- Directory Selection ---\n        select_layout = QHBoxLayout()\n        self.dir_label = QLabel(\"Start Directory:\")\n        self.dir_edit = QLineEdit()\n        self.dir_edit.setReadOnly(True)\n        self.browse_button = QPushButton(\"Browse...\")\n        self.browse_button.clicked.connect(self.browse_directory)\n        select_layout.addWidget(self.dir_label)\n        select_layout.addWidget(self.dir_edit)\n        select_layout.addWidget(self.browse_button)\n        self.layout.addLayout(select_layout)\n\n        # --- Control Buttons ---\n        button_layout = QHBoxLayout()\n        self.find_button = QPushButton(\"Find Empty Folders\")\n        self.find_button.clicked.connect(self.start_find_task)\n        self.delete_button = QPushButton(\"Delete Selected Folders\")\n        self.delete_button.clicked.connect(self.start_delete_task)\n        self.delete_button.setEnabled(False)\n        self.stop_button = QPushButton(\"Stop Operation\")\n        self.stop_button.clicked.connect(self.stop_task)\n        self.stop_button.setEnabled(False)\n        button_layout.addWidget(self.find_button)\n        button_layout.addWidget(self.delete_button)\n        button_layout.addStretch() # Push stop button to the right\n        button_layout.addWidget(self.stop_button)\n        self.layout.addLayout(button_layout)\n\n        # --- Results List ---\n        self.results_label = QLabel(\"Found Empty Folders (select folders to delete):\")\n        self.results_list = QListWidget()\n        self.results_list.setSelectionMode(QAbstractItemView.ExtendedSelection)\n        self.layout.addWidget(self.results_label)\n        self.layout.addWidget(self.results_list)\n\n        # Selection Helper Buttons\n        select_buttons_layout = QHBoxLayout()\n        self.select_all_button = QPushButton(\"Select All\")\n        self.select_all_button.clicked.connect(self.select_all_items)\n        self.deselect_all_button = QPushButton(\"Deselect All\")\n        self.deselect_all_button.clicked.connect(self.deselect_all_items)\n        select_buttons_layout.addWidget(self.select_all_button)\n        select_buttons_layout.addWidget(self.deselect_all_button)\n        select_buttons_layout.addStretch()\n        self.layout.addLayout(select_buttons_layout)\n\n        # --- Status Bar ---\n        self.status_bar = QStatusBar()\n        self.setStatusBar(self.status_bar)\n        self.status_bar.showMessage(\"Ready\")\n\n    def browse_directory(self):\n        dir_path = QFileDialog.getExistingDirectory(self, \"Select Starting Directory\")\n        if dir_path:\n            self.dir_edit.setText(dir_path)\n            self.results_list.clear()\n            self.delete_button.setEnabled(False)\n            self.status_bar.showMessage(f\"Directory selected: {dir_path}\")\n\n    def toggle_controls(self, enable):\n        \"\"\"Enable/disable controls during operation.\"\"\"\n        self.browse_button.setEnabled(enable)\n        self.find_button.setEnabled(enable)\n        # Delete button is enabled only if items are found AND operation isn't running\n        self.delete_button.setEnabled(enable and self.results_list.count() > 0)\n        self.select_all_button.setEnabled(enable and self.results_list.count() > 0)\n        self.deselect_all_button.setEnabled(enable and self.results_list.count() > 0)\n        # Stop button is enabled only when an operation IS running\n        self.stop_button.setEnabled(not enable)\n\n    def start_find_task(self):\n        start_path = self.dir_edit.text()\n        if not start_path or not os.path.isdir(start_path):\n            QMessageBox.warning(self, \"Invalid Directory\", \"Please select a valid starting directory.\")\n            return\n\n        if self.thread and self.thread.isRunning():\n            QMessageBox.warning(self, \"Busy\", \"An operation is already in progress.\")\n            return\n\n        self.results_list.clear()\n        self.status_bar.showMessage(\"Starting scan...\")\n        self.toggle_controls(False)\n\n        self.thread = QThread()\n        self.worker = Worker(self.logic) # Pass the single logic instance\n        self.worker.moveToThread(self.thread)\n\n        # Connect worker signals to GUI slots\n        self.worker.progress_updated.connect(self.update_status)\n        self.worker.folders_found.connect(self.populate_results)\n        self.worker.error_occurred.connect(self.show_error)\n        self.worker.finished.connect(self.on_task_finished)\n        # Deletion signals are not needed for find task\n\n        self.thread.started.connect(lambda: self.worker.start_find(start_path))\n        self.thread.start()\n\n    def start_delete_task(self):\n        selected_items = self.results_list.selectedItems()\n        if not selected_items:\n            QMessageBox.warning(self, \"No Selection\", \"Please select folders to delete from the list.\")\n            return\n\n        folders_to_delete = [item.text() for item in selected_items]\n\n        reply = QMessageBox.warning(self, \"Confirm Deletion\",\n                                    f\"Are you sure you want to permanently delete {len(folders_to_delete)} selected folder(s)?\\n\\nThis action cannot be undone.\",\n                                    QMessageBox.Yes | QMessageBox.No, QMessageBox.No)\n\n        if reply == QMessageBox.No:\n            return\n\n        if self.thread and self.thread.isRunning():\n            QMessageBox.warning(self, \"Busy\", \"An operation is already in progress.\")\n            return\n\n        self.status_bar.showMessage(\"Starting deletion...\")\n        self.toggle_controls(False)\n\n        self.thread = QThread()\n        self.worker = Worker(self.logic) # Pass the single logic instance\n        self.worker.moveToThread(self.thread)\n\n        # Connect worker signals to GUI slots\n        self.worker.progress_updated.connect(self.update_status)\n        self.worker.deletion_update.connect(self.update_deletion_status)\n        self.worker.error_occurred.connect(self.show_error)\n        self.worker.finished.connect(self.on_task_finished)\n        # Folders found signal not needed for delete task\n\n        self.thread.started.connect(lambda: self.worker.start_delete(folders_to_delete))\n        self.thread.start()\n\n    def stop_task(self):\n        if self.worker:\n             self.update_status(\"Stopping...\")\n             self.worker.stop()\n             self.stop_button.setEnabled(False) # Prevent multiple clicks\n\n    def update_status(self, message):\n        self.status_bar.showMessage(message)\n\n    def show_error(self, message):\n        QMessageBox.critical(self, \"Error\", message)\n        self.update_status(f\"Error occurred: {message}\")\n\n    def populate_results(self, folders):\n        self.results_list.clear()\n        if folders:\n             # Sort for display consistency\n            folders.sort()\n            for folder in folders:\n                item = QListWidgetItem(folder)\n                self.results_list.addItem(item)\n            self.delete_button.setEnabled(True)\n            self.select_all_button.setEnabled(True)\n            self.deselect_all_button.setEnabled(True)\n            self.update_status(f\"Found {len(folders)} empty folders.\")\n        else:\n            self.update_status(\"No empty folders found in the selected directory.\")\n            self.delete_button.setEnabled(False)\n            self.select_all_button.setEnabled(False)\n            self.deselect_all_button.setEnabled(False)\n\n    def update_deletion_status(self, path_or_message, success):\n        # Find the item in the list (might be slow for huge lists, but ok for moderate)\n        items = self.results_list.findItems(path_or_message.split(' (')[0], Qt.MatchExactly)\n        if items:\n            item = items[0]\n            if success:\n                item.setForeground(QColor('gray')) # Mark as deleted\n                item.setText(f\"[DELETED] {path_or_message}\")\n                item.setSelected(False) # Deselect after deletion\n            else:\n                item.setForeground(QColor('red')) # Mark as failed\n                item.setText(f\"[FAILED] {path_or_message}\")\n        else:\n             # Could be a message like 'Not found...' - display in status bar for now\n             if not success:\n                  self.status_bar.showMessage(f\"Deletion info: {path_or_message}\", 4000)\n\n    def select_all_items(self):\n         self.results_list.selectAll()\n\n    def deselect_all_items(self):\n         self.results_list.clearSelection()\n\n    def on_task_finished(self, mode_flag):\n        if self.thread is None: return # Safety check\n\n        self.thread.quit()\n        self.thread.wait()\n\n        # Get final status message before resetting controls\n        final_message = self.status_bar.currentMessage()\n\n        self.thread = None\n        self.worker = None\n        # Don't reset self.logic, it's reused\n\n        self.toggle_controls(True)\n        self.stop_button.setEnabled(False) # Ensure stop is disabled\n\n        # Restore a sensible status message if not an error/cancellation\n        if \"Error\" not in final_message and \"Stopping\" not in final_message and \"cancelled\" not in final_message:\n             self.status_bar.showMessage(\"Operation finished.\", 5000)\n        elif \"cancelled\" in final_message or \"Stopping\" in final_message:\n             self.status_bar.showMessage(\"Operation cancelled.\", 5000)\n\n        # After deletion, refresh the list to show only remaining/failed items\n        # This requires iterating and removing grayed out items, or re-finding.\n        # For simplicity now, we leave them grayed out.\n        # If a re-find is desired, uncomment below:\n        # if not mode_flag: # if deletion finished (False) and not cancelled\n        #      if \"cancelled\" not in final_message:\n        #          self.start_find_task() # Optionally re-scan to update list\n\n\n    def closeEvent(self, event):\n        # Ensure thread is stopped cleanly on exit\n        if self.thread is not None and self.thread.isRunning():\n            self.status_bar.showMessage(\"Stopping background task before closing...\")\n            if self.worker:\n                 self.worker.stop()\n            self.thread.quit()\n            self.thread.wait(3000) # Wait max 3 seconds\n        event.accept()\n\nif __name__ == '__main__':\n    app = QApplication(sys.argv)\n    main_win = EmptyFolderCleanerApp()\n    main_win.show()\n    sys.exit(app.exec_())\n"
