#!/usr/bin/env python3
"""
File Checksum Tool for Richard's File Utilities

A comprehensive checksum calculation and verification utility.
"""

import os
import sys
import hashlib
try:
    from PyQt5.QtWidgets import (
        QMainWindow, QWidget, QVBoxLayout, QHBoxLayout, QGridLayout,
        QPushButton, QLineEdit, QListWidget, QListWidgetItem, QLabel,
        QCheckBox, QGroupBox, QFileDialog, QMessageBox, QProgressBar,
        QApplication, QTextEdit, QComboBox, QSplitter
    )
    from PyQt5.QtCore import Qt, QThread, pyqtSignal
except ImportError:
    print("PyQt5 not available. Please install PyQt5.")
    sys.exit(1)


class ChecksumWorker(QThread):
    """Worker thread for checksum calculations."""
    
    progress_updated = pyqtSignal(int)
    file_processed = pyqtSignal(str, str, str)  # file_path, algorithm
    finished = pyqtSignal()
    error_occurred = pyqtSignal(str)
    
    def __init__(self, files, algorithm):
        super().__init__()
        self.files = files
        self.algorithm = algorithm
        self.is_cancelled = False
        
    def run(self):
        """Calculate checksums for files."""
        try:
            total_files = len(self.files)
            
            for i, file_path in enumerate(self.files):
                if self.is_cancelled:
                    break
                    
                try:
                    checksum = self.calculate_checksum(file_path,
                                                       self.algorithm)
                    self.file_processed.emit(file_path, self.algorithm,
                                             checksum)
                except Exception as e:
                    error_msg = f"Error processing {file_path}: {str(e)}"
                    self.error_occurred.emit(error_msg)
                
                progress = int((i + 1) / total_files * 100)
                self.progress_updated.emit(progress)
                
            self.finished.emit()
            
        except Exception as e:
            self.error_occurred.emit(f"Worker error: {str(e)}")
    
    def calculate_checksum(self, file_path, algorithm):
        """Calculate checksum for a single file."""
        hash_obj = hashlib.new(algorithm)
        
        with open(file_path, 'rb') as f:
            while chunk := f.read(8192):
                if self.is_cancelled:
                    break
                hash_obj.update(chunk)
                
        return hash_obj.hexdigest()
    
    def cancel(self):
        """Cancel the operation."""
        self.is_cancelled = True


class ChecksumGUI(QMainWindow):
    """File Checksum Calculator and Verifier GUI."""
    
    def __init__(self):
        super().__init__()
        self.worker = None
        self.checksum_results = {}
        self.init_ui()
        
    def init_ui(self):
        """Initialize the user interface."""
        self.setWindowTitle("File Checksum - Richard's File Utilities")
        self.setGeometry(100, 100, 900, 700)
        
        # Create central widget and main layout
        central_widget = QWidget()
        self.setCentralWidget(central_widget)
        layout = QVBoxLayout(central_widget)
        
        # Create header
        header_label = QLabel("File Checksum Calculator & Verifier")
        header_label.setStyleSheet("""
            QLabel {
                font-size: 18px;
                font-weight: bold;
                color: #2c3e50;
                padding: 10px;
                background-color: #ecf0f1;
                border-radius: 5px;
                margin-bottom: 10px;
            }
        """)
        layout.addWidget(header_label)
        
        # Create main splitter
        splitter = QSplitter(Qt.Orientation.Vertical)
        layout.addWidget(splitter)
        
        # Create input section
        input_group = QGroupBox("File Selection & Settings")
        input_layout = QGridLayout(input_group)
        
        # File selection
        input_layout.addWidget(QLabel("Files:"), 0, 0)
        self.files_edit = QLineEdit()
        self.files_edit.setPlaceholderText(
            "Select files to calculate checksums...")
        self.files_edit.setReadOnly(True)
        input_layout.addWidget(self.files_edit, 0, 1)
        
        self.browse_files_button = QPushButton("Browse Files")
        self.browse_files_button.clicked.connect(self.browse_files)
        input_layout.addWidget(self.browse_files_button, 0, 2)
        
        self.browse_folder_button = QPushButton("Browse Folder")
        self.browse_folder_button.clicked.connect(self.browse_folder)
        input_layout.addWidget(self.browse_folder_button, 0, 3)
        
        # Algorithm selection
        input_layout.addWidget(QLabel("Algorithm:"), 1, 0)
        self.algorithm_combo = QComboBox()
        self.algorithm_combo.addItems(['md5', 'sha1', 'sha256', 'sha512'])
        self.algorithm_combo.setCurrentText('sha256')
        input_layout.addWidget(self.algorithm_combo, 1, 1)
        
        # Options
        self.recursive_check = QCheckBox("Include subdirectories")
        self.recursive_check.setChecked(True)
        input_layout.addWidget(self.recursive_check, 1, 2)
        
        # Calculate button
        self.calculate_button = QPushButton("Calculate Checksums")
        self.calculate_button.clicked.connect(self.start_calculation)
        self.calculate_button.setStyleSheet("""
            QPushButton {
                background-color: #27ae60;
                color: white;
                border: none;
                padding: 8px 16px;
                border-radius: 4px;
                font-weight: bold;
            }
            QPushButton:hover {
                background-color: #229954;
            }
            QPushButton:disabled {
                background-color: #95a5a6;
            }
        """)
        input_layout.addWidget(self.calculate_button, 2, 0, 1, 4)
        
        splitter.addWidget(input_group)
        
        # Create progress section
        progress_group = QGroupBox("Progress")
        progress_layout = QVBoxLayout(progress_group)
        
        self.progress_bar = QProgressBar()
        self.progress_bar.setVisible(False)
        progress_layout.addWidget(self.progress_bar)
        
        self.status_label = QLabel("Ready to calculate checksums")
        progress_layout.addWidget(self.status_label)
        
        splitter.addWidget(progress_group)
        
        # Create results section
        results_group = QGroupBox("Checksum Results")
        results_layout = QVBoxLayout(results_group)
        
        # Results list
        self.results_list = QListWidget()
        self.results_list.itemClicked.connect(self.show_checksum_details)
        results_layout.addWidget(self.results_list)
        
        # Details panel
        details_label = QLabel("Checksum Details:")
        results_layout.addWidget(details_label)
        
        self.details_text = QTextEdit()
        self.details_text.setMaximumHeight(120)
        self.details_text.setReadOnly(True)
        results_layout.addWidget(self.details_text)
        
        # Action buttons
        button_layout = QHBoxLayout()
        
        self.save_button = QPushButton("Save Results")
        self.save_button.clicked.connect(self.save_results)
        self.save_button.setEnabled(False)
        button_layout.addWidget(self.save_button)
        
        self.verify_button = QPushButton("Verify Checksums")
        self.verify_button.clicked.connect(self.verify_checksums)
        self.verify_button.setEnabled(False)
        button_layout.addWidget(self.verify_button)
        
        self.copy_button = QPushButton("Copy Selected")
        self.copy_button.clicked.connect(self.copy_selected_checksum)
        self.copy_button.setEnabled(False)
        button_layout.addWidget(self.copy_button)
        
        self.clear_button = QPushButton("Clear Results")
        self.clear_button.clicked.connect(self.clear_results)
        button_layout.addWidget(self.clear_button)
        
        results_layout.addLayout(button_layout)
        splitter.addWidget(results_group)
        
        # Set splitter proportions
        splitter.setSizes([150, 50, 400])
        
        # Store selected files
        self.selected_files = []
        
    def browse_files(self):
        """Browse for individual files."""
        files, _ = QFileDialog.getOpenFileNames(
            self, "Select Files for Checksum Calculation", "",
            "All Files (*.*)"
        )
        if files:
            self.selected_files = files
            self.files_edit.setText(f"{len(files)} file(s) selected")
            
    def browse_folder(self):
        """Browse for folder and get all files."""
        folder = QFileDialog.getExistingDirectory(
            self, "Select Folder for Checksum Calculation"
        )
        if folder:
            files = []
            if self.recursive_check.isChecked():
                for root, dirs, filenames in os.walk(folder):
                    for filename in filenames:
                        files.append(os.path.join(root, filename))
            else:
                for filename in os.listdir(folder):
                    file_path = os.path.join(folder, filename)
                    if os.path.isfile(file_path):
                        files.append(file_path)
            
            self.selected_files = files
            self.files_edit.setText(f"{len(files)} file(s) from folder")
            
    def start_calculation(self):
        """Start checksum calculation."""
        if not self.selected_files:
            QMessageBox.warning(self, "Warning", "Please select files first.")
            return
            
        algorithm = self.algorithm_combo.currentText()
        
        # Clear previous results
        self.clear_results()
        
        # Setup UI for calculation
        self.calculate_button.setEnabled(False)
        self.progress_bar.setVisible(True)
        self.progress_bar.setValue(0)
        status_msg = f"Calculating {algorithm.upper()} checksums..."
        self.status_label.setText(status_msg)
        
        # Start worker thread
        self.worker = ChecksumWorker(self.selected_files, algorithm)
        self.worker.progress_updated.connect(self.update_progress)
        self.worker.file_processed.connect(self.add_result)
        self.worker.finished.connect(self.calculation_finished)
        self.worker.error_occurred.connect(self.show_error)
        self.worker.start()
        
    def update_progress(self, value):
        """Update progress bar."""
        self.progress_bar.setValue(value)
        
    def add_result(self, file_path, algorithm, checksum):
        """Add checksum result to the list."""
        filename = os.path.basename(file_path)
        item_text = f"{filename} - {algorithm.upper()}: {checksum[:16]}..."
        item = QListWidgetItem(item_text)
        item.setData(Qt.ItemDataRole.UserRole, {
            'file_path': file_path,
            'algorithm': algorithm,
            'checksum': checksum
        })
        self.results_list.addItem(item)
        
        # Store result
        self.checksum_results[file_path] = {
            'algorithm': algorithm,
            'checksum': checksum
        }
        
    def calculation_finished(self):
        """Handle calculation completion."""
        self.calculate_button.setEnabled(True)
        self.progress_bar.setVisible(False)
        count = len(self.checksum_results)
        self.status_label.setText(f"Completed - {count} checksums calculated")
        
        # Enable action buttons
        self.save_button.setEnabled(True)
        self.verify_button.setEnabled(True)
        
        if self.worker:
            self.worker.deleteLater()
            self.worker = None
            
    def show_error(self, error_message):
        """Show error message."""
        QMessageBox.warning(self, "Error", error_message)
        
    def show_checksum_details(self, item):
        """Show detailed information about selected checksum."""
        data = item.data(Qt.ItemDataRole.UserRole)
        if data:
            file_path = data['file_path']
            algorithm = data['algorithm']
            checksum = data['checksum']
            
            try:
                stat = os.stat(file_path)
                file_size = stat.st_size
                
                # Format file size
                if file_size < 1024:
                    size_str = f"{file_size} bytes"
                elif file_size < 1024 * 1024:
                    size_str = f"{file_size / 1024:.1f} KB"
                elif file_size < 1024 * 1024 * 1024:
                    size_str = f"{file_size / (1024 * 1024):.1f} MB"
                else:
                    size_str = f"{file_size / (1024 * 1024 * 1024):.1f} GB"
                
                import time as time_module
                modified_time = time_module.ctime(stat.st_mtime)
                
                details_text = f"""File: {os.path.basename(file_path)}
Path: {file_path}
Size: {size_str}
Modified: {modified_time}
Algorithm: {algorithm.upper()}
Checksum: {checksum}"""
                
                self.details_text.setText(details_text)
                self.copy_button.setEnabled(True)
                
            except Exception as e:
                self.details_text.setText(f"Error reading file details: {e}")
                self.copy_button.setEnabled(False)
                
    def save_results(self):
        """Save checksum results to file."""
        if not self.checksum_results:
            QMessageBox.warning(self, "Warning", "No results to save.")
            return
            
        file_path, _ = QFileDialog.getSaveFileName(
            self, "Save Checksum Results", "checksums.txt",
            "Text Files (*.txt);;All Files (*.*)"
        )
        
        if file_path:
            try:
                with open(file_path, 'w') as f:
                    f.write("File Checksum Results\n")
                    f.write("=" * 50 + "\n\n")
                    
                    for file_path, data in self.checksum_results.items():
                        f.write(f"File: {file_path}\n")
                        f.write(f"Algorithm: {data['algorithm'].upper()}\n")
                        f.write(f"Checksum: {data['checksum']}\n")
                        f.write("-" * 30 + "\n")
                        
                QMessageBox.information(self, "Success",
                                        "Results saved successfully.")
                
            except Exception as e:
                QMessageBox.warning(self, "Error",
                                    f"Failed to save results: {e}")
                
    def verify_checksums(self):
        """Verify existing checksums."""
        file_path, _ = QFileDialog.getOpenFileName(
            self, "Select Checksum File to Verify", "",
            "Text Files (*.txt);;All Files (*.*)"
        )
        
        if file_path:
            try:
                # Simple verification implementation
                msg = ("Checksum verification feature will compare stored "
                       "checksums with recalculated values. This is a "
                       "placeholder for the full implementation.")
                QMessageBox.information(self, "Verification", msg)
            except Exception as e:
                QMessageBox.warning(self, "Error", f"Verification failed: {e}")
                
    def copy_selected_checksum(self):
        """Copy selected checksum to clipboard."""
        current_item = self.results_list.currentItem()
        if current_item:
            data = current_item.data(Qt.ItemDataRole.UserRole)
            if data:
                checksum = data['checksum']
                clipboard = QApplication.clipboard()
                if clipboard:
                    clipboard.setText(checksum)
                    self.status_label.setText("Checksum copied to clipboard")
                
    def clear_results(self):
        """Clear all results."""
        self.results_list.clear()
        self.details_text.clear()
        self.checksum_results.clear()
        self.status_label.setText("Ready to calculate checksums")
        
        # Disable action buttons
        self.save_button.setEnabled(False)
        self.verify_button.setEnabled(False)
        self.copy_button.setEnabled(False)
        
    def closeEvent(self, event):
        """Handle window close event."""
        if self.worker and self.worker.isRunning():
            self.worker.cancel()
            self.worker.wait()
        super().closeEvent(event)


def main():
    """Main function for standalone execution."""
    app = QApplication(sys.argv)
    window = ChecksumGUI()
    window.show()
    sys.exit(app.exec_())


if __name__ == "__main__":
    main()