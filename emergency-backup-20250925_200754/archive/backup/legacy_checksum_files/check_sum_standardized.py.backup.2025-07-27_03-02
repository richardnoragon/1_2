        main_layout.addWidget(self.progress_bar)
        
        # Action buttons
        button_layout = QHBoxLayout()
        button_layout.setSpacing(10)
        
        calculate_btn = QPushButton("Calculate Checksum")
        ThemeManager.style_primary_button(calculate_btn)
        calculate_btn.clicked.connect(self.calculate_checksum)
        
