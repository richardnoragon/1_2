  <property name="styleSheet">
   <string notr="true">QMainWindow {
    background-color: #f5f5f5;
    font-size: 12pt;
}
QPushButton {
    background-color: #4285f4;
    color: white;
    border: none;
    border-radius: 4px;
    padding: 6px 12px;
    min-height: 24px;
    font-size: 12pt;
}
QPushButton:hover {
    background-color: #3275e4;
}
QPushButton:pressed {
    background-color: #2265d4;
}
QListView, QTableView {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    background-color: white;
    font-size: 12pt;
}
QCheckBox, QRadioButton {
    spacing: 8px;
    font-size: 12pt;
}
QGroupBox {
    border: 1px solid #dcdcdc;
    border-radius: 4px;
    margin-top: 1ex;
    padding-top: 1ex;
    background-color: #ffffff;
    font-size: 12pt;
}
QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top center;
    padding: 0 5px;
}
QLabel {
    font-size: 12pt;
}
QLineEdit {
    font-size: 12pt;
}
QDateEdit {
    font-size: 12pt;
}</string>
